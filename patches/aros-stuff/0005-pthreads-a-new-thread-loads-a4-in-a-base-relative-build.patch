---
diff --git a/pthreads/pthread.c b/pthreads/pthread.c
index 1c07654..5c0174e 100644
--- a/pthreads/pthread.c
+++ b/pthreads/pthread.c
@@ -1412,7 +1412,20 @@ AROS_UFH3S(ULONG, CancelHandler,
 }
 #endif
 
+#ifdef __baserel__
+// The new process starts with no a4 of its own. In a base-relative program
+// (-fbaserel, -fbaserel32) the startup code's geta4 loads the program's a4
+// before anything reads data; the body is a separate function so that GCC
+// cannot touch a4 data before that.
+static void StarterBody(void) __attribute__((noinline));
 static void StarterFunc(void) {
+	__asm__ volatile ("jsr _geta4" : : : "memory");
+	StarterBody();
+}
+static void StarterBody(void) {
+#else
+static void StarterFunc(void) {
+#endif
 	ThreadInfo *inf;
 	void *ret;
 	pthread_t pid;

+/* Find the base (a pointer or an object) and the constant byte offset of the
+   start of block MEM.  Return NULL_TREE if they can't be told.  */
+static tree
+m68k_block_base (rtx mem, HOST_WIDE_INT *off)
+{
+  tree expr = MEM_EXPR (mem);
+  if (!expr || !MEM_OFFSET_KNOWN_P (mem) || !MEM_OFFSET (mem).is_constant ())
+    return NULL_TREE;
+
+  poly_int64 bitsize, bitpos;
+  tree offset;
+  machine_mode mode;
+  int unsignedp, reversep, volatilep;
+  tree base = get_inner_reference (expr, &bitsize, &bitpos, &offset, &mode,
+				   &unsignedp, &reversep, &volatilep);
+  if (!base || offset || !bitpos.is_constant ()
+      || bitpos.to_constant () % BITS_PER_UNIT)
+    return NULL_TREE;
+
+  *off = bitpos.to_constant () / BITS_PER_UNIT + MEM_OFFSET (mem).to_constant ();
+  if (TREE_CODE (base) == MEM_REF || TREE_CODE (base) == TARGET_MEM_REF)
+    {
+      if (TREE_CODE (base) == TARGET_MEM_REF
+	  && (TMR_INDEX (base) || TMR_INDEX2 (base)))
+	return NULL_TREE;
+      *off += mem_ref_offset (base).force_shwi ();
+      return m68k_pointer_base (TREE_OPERAND (base, 0), off);
+    }
+  return base;
+}

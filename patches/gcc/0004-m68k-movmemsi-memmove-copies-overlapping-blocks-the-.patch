+/* Expand a block copy of constant LENGTH.  MAY_OVERLAP is true for movmemsi
+   (memmove), false for cpymemsi (memcpy).  Return false to let GCC call the
+   library function instead.  */
+int
+m68k_emit_movmemsi (rtx blkdest, rtx blksrc, rtx length, rtx alignment,
+		    bool may_overlap)
+{
+  int align = INTVAL (alignment);
+  int size = INTVAL (length);
+  int n = optimize_size ? 4 : 16;
+  int units = (align == 1 && TUNE_68000_10) ? size : size / 4;
+
+  if (units / n - 1 > (int) get_env_uint ("M68K_MOVMEMSI_MAX_NLOOPS", 63))
+    return false;
+
+  int dir = may_overlap ? m68k_block_move_direction (blkdest, blksrc, size) : 0;
+  if (dir >= 0)
     {
-      src = gen_rtx_MEM(QImode, backward ? gen_rtx_PRE_DEC(SImode, regsrc)
-                                         : gen_rtx_POST_INC(SImode, regsrc));
-      dst = gen_rtx_MEM(QImode, backward ? gen_rtx_PRE_DEC(SImode, regdst)
-                                         : gen_rtx_POST_INC(SImode, regdst));
-
-      rtx_insn *insn = emit_move_insn(dst, src);
-      add_reg_note(insn, REG_INC, regsrc);
-      add_reg_note(insn, REG_INC, regdst);
+      m68k_emit_block_copy (XEXP (blkdest, 0), XEXP (blksrc, 0), size, align,
+			    dir == 1);
+      return true;
     }
 
+  /* The direction is only known at run time.  At -Os, memmove is smaller.  */
+  if (optimize_size)
+    return false;
+
+  rtx dstaddr = force_reg (Pmode, XEXP (blkdest, 0));
+  rtx srcaddr = force_reg (Pmode, XEXP (blksrc, 0));
+  rtx_code_label *back = gen_label_rtx ();
+  rtx_code_label *done = gen_label_rtx ();
+
+  /* Destination above the source: copy backwards.  */
+  emit_cmp_and_jump_insns (dstaddr, srcaddr, GTU, NULL_RTX, Pmode, 1, back);
+  m68k_emit_block_copy (dstaddr, srcaddr, size, align, false);
+  emit_jump_insn (targetm.gen_jump (done));
+  emit_barrier ();
+  emit_label (back);
+  m68k_emit_block_copy (dstaddr, srcaddr, size, align, true);
+  emit_label (done);
   return true;
 }

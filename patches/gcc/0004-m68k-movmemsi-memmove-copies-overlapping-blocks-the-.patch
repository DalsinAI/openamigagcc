+/* For a copy of SIZE bytes from SRC to DST: 1 if it must go backwards (DST
+   lies above SRC inside the source block), 0 if a forward copy is safe, -1
+   if this can't be told at compile time.  */
+static int
+m68k_block_move_direction (rtx dst, rtx src, HOST_WIDE_INT size)
+{
+  poly_int64 pd, ps;
+  rtx rd = strip_offset (XEXP (dst, 0), &pd);
+  rtx rs = strip_offset (XEXP (src, 0), &ps);
+  HOST_WIDE_INT d, s;
+  if (rtx_equal_p (rd, rs) && pd.is_constant (&d) && ps.is_constant (&s))
+    return d > s && d < s + size;
+
+  tree bd = m68k_block_base (dst, &d);
+  tree bs = bd ? m68k_block_base (src, &s) : NULL_TREE;
+  if (!bd || !bs)
+    return -1;
+  if (operand_equal_p (bd, bs, 0))
+    return d > s && d < s + size;
+  /* Two different declared objects never overlap.  */
+  if (DECL_P (bd) && DECL_P (bs))
+    return 0;
+  return -1;
+}

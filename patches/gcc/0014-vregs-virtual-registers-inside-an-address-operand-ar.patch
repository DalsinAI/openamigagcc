From b2173404b6633c8a404e2cfb9af76662c1cba524 Mon Sep 17 00:00:00 2001
From: SacredTrees <121399723+SacredTrees@users.noreply.github.com>
Date: Sun, 25 Oct 2026 09:15:07 +0000
Subject: [PATCH] vregs: virtual registers inside an address operand are
 instantiated too

instantiate_virtual_regs_in_insn replaced virtual registers only in
operands that are registers, subregs or memory, and skipped any other
operand. An address operand, such as the source of m68k's *lea,
(set (reg) (match_operand:QI 1 "address_operand" "p")), kept its virtual
register. The m68k back end's inline block copy (m68k2.cc) loads the
destination address with emit_move_insn, so strcat(want, phrase), want a
local array and phrase a constant, put after the call to strlen

    (set (reg 799) (plus (plus (reg virtual-stack-vars) (reg 71))
                         (const_int -600)))

virtual-stack-vars stayed after vregs, combine then dropped it, and the
copy went to strlen(want) - 600, an absolute address: GFOffice's
OWFLibTest never built the text it checks owf_inflate's output against.
It showed with -m68020 and -m68040 at -O1 and -O2, not with -m68000 or
at -Os; -fno-builtin-strcat hid it.

Such an operand is now instantiated where it is, and computed into a
register if the insn does not take the new address. match_operator
operands are left alone: their operands are operands of their own. The
copy now starts with "lea 12(sp,d0.l),a0", the array plus its length.

GCC's trunk has the same operand loop and the same *lea; no upstream
report was found. Upstream's expanders put addresses in registers with
force_operand, whose additions vregs does handle.

tests/repro/vregs.c is OWFLibTest's strcat reduced; prove.sh runs it and
checks the vregs dump for any virtual register.
---
 gcc/function.cc | 24 ++++++++++++++++++++++--
 1 file changed, 22 insertions(+), 2 deletions(-)

diff --git a/gcc/function.cc b/gcc/function.cc
index 24ca0f47d..e1d0f93de 100644
--- a/gcc/function.cc
+++ b/gcc/function.cc
@@ -1661,7 +1661,8 @@ instantiate_virtual_regs_in_insn (rtx_insn *insn)
     }
 
   /* In the general case, we expect virtual registers to appear only in
-     operands, and then only as either bare registers or inside memories.  */
+     operands, and then only as either bare registers or inside memories
+     or addresses.  */
   for (i = 0; i < recog_data.n_operands; ++i)
     {
       x = recog_data.operand[i];
@@ -1738,7 +1739,26 @@ instantiate_virtual_regs_in_insn (rtx_insn *insn)
 	  break;
 
 	default:
-	  continue;
+	  /* An address operand (address_operand, a "p" constraint), such
+	     as the source of m68k's lea: the virtual registers are inside
+	     the address expression.  Instantiate them there, and if the
+	     insn does not take the new address, compute it into a
+	     register.  Operators are skipped: their operands are operands
+	     of their own.  */
+	  if (recog_data.is_operator[i])
+	    continue;
+	  x = copy_rtx (x);
+	  if (!instantiate_virtual_regs_in_rtx (&x))
+	    continue;
+	  if (!safe_insn_predicate (insn_code, i, x))
+	    {
+	      start_sequence ();
+	      x = force_operand (x, NULL_RTX);
+	      seq = end_sequence ();
+	      if (seq)
+		emit_insn_before (seq, insn);
+	    }
+	  break;
 	}
 
       /* At this point, X contains the new value for the operand.
-- 

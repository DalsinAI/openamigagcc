From 61ddc15ebe6d48b18b27940b18e6cbbc47e140e5 Mon Sep 17 00:00:00 2001
From: SacredTrees <121399723+SacredTrees@users.noreply.github.com>
Date: Mon, 12 Oct 2026 08:26:48 +0100
Subject: [PATCH] setlocale: safe from several threads at once (libstdc++
 number conversions)

libstdc++'s generic locale model calls setlocale() two or three times for
every floating-point number a stream writes or reads: it asks for the
current name, sets "C", converts, and sets the saved name back. From
several threads at once this freed the same returned name twice and closed
the same locale twice (t18: 8 threads with ostringstream/istringstream hung
the system or ended the Shell running them).

- One semaphore makes the calls one at a time.
- A name setlocale() returns stays valid until the program ends; the same
  name is the same string.
- A locale setlocale() opens stays open until the program ends, closed in
  __exitlocale(). A name it has opened or returned before (including the
  default locale's loc_LocaleName, which OpenLocale() can't open by name)
  finds that locale again, so "C" and back neither closes nor reloads it,
  and __decimalpoint, __lconv and strftime() never point into a closed one.
- A name with one part per category ("a\nb\n...", as setlocale(LC_ALL, NULL)
  returns it) sets each category to its own part; before, every category
  after the first got "", the default locale.
- "C" sets __decimalpoint back to ".", so printf() and scanf() follow it.
- A query no longer resets __lconv.
---
 sources/nix20/locale/setlocale.c | 236 +++++++++++++++++++++++--------
 1 file changed, 174 insertions(+), 62 deletions(-)

diff --git a/sources/nix20/locale/setlocale.c b/sources/nix20/locale/setlocale.c
index 9630158..857345d 100644
--- a/sources/nix20/locale/setlocale.c
+++ b/sources/nix20/locale/setlocale.c
@@ -3,6 +3,7 @@
 #include <string.h>
 #include <stdlib.h>
 #include <dos/dos.h>
+#include <exec/semaphores.h>
 #ifndef __KICK13__
 #include <libraries/locale.h>
 #include <proto/locale.h>
@@ -33,62 +34,140 @@ int __locale_mb_cur_max(void) {
 	return 0xff;
 }
 
-char *setlocale(int category, const char *name) {
-	static char *string = NULL;
-	size_t i, a, b;
-	struct Locale *vec[5];
-	char *s1, *s2, c;
+/* setlocale() is called from several threads at once: libstdc++'s generic
+   locale model calls it two or three times for every floating-point number a
+   stream writes or reads (it asks for the current name, sets "C", converts,
+   and sets the saved name back). So:
+   - one semaphore makes the calls one at a time;
+   - a name setlocale() returns stays valid until the program ends, so
+     another thread's call can't free it while the caller copies it;
+   - a locale setlocale() opens stays open until the program ends, and a
+     name it has opened or returned before finds that locale again. Setting
+     "C" and back never closes and reopens a locale, and __decimalpoint,
+     __lconv and strftime() never point into a closed one.
+   Before, every call freed the last returned name, and every change closed
+   the locales in use: several threads at once freed the same name twice and
+   closed the same locale twice (t18, 11-12 Oct 2026). */
+static struct SignalSemaphore __localesema;
+static volatile int __localesema_ready;
 
-	// set defaults
-	__lconv.decimal_point = ".";
-	__lconv.thousands_sep = "";
+struct __localename {
+	struct __localename *next;
+	char name[1];
+};
+static struct __localename *__localenames; /* every name returned */
 
-	if (string != NULL) /* Free string if possible */
-	{
-		free(string);
-		string = NULL;
+#ifndef __KICK13__
+struct __localeopen {
+	struct __localeopen *next;
+	struct Locale *locale;
+	char name[1];
+};
+static struct __localeopen *__localesopen; /* every locale opened */
+static struct Locale *__ctypelocale; /* the locale ctype[] was made from */
+#endif
+
+static void __localelock(void) {
+	if (!__localesema_ready) {
+		Forbid();
+		if (!__localesema_ready) {
+			InitSemaphore(&__localesema);
+			__localesema_ready = 1;
+		}
+		Permit();
 	}
+	ObtainSemaphore(&__localesema);
+}
 
-	if (category < 0 || category > 5)
+static void __localeunlock(void) {
+	ReleaseSemaphore(&__localesema);
+}
+
+/* the kept copy of name: the same string every time for the same name */
+static char *__keepname(const char *name) {
+	struct __localename *n;
+	for (n = __localenames; n != NULL; n = n->next)
+		if (strcmp(n->name, name) == 0)
+			return n->name;
+	if ((n = malloc(sizeof(*n) + strlen(name))) == NULL)
 		return NULL;
+	strcpy(n->name, name);
+	n->next = __localenames;
+	__localenames = n;
+	return n->name;
+}
 
-	if (category == LC_ALL) {
-		a = 0;
-		b = 4;
-	} else
-		a = b = category - 1;
+#ifndef __KICK13__
+/* the locale called name ("" for the user's default), opened once */
+static struct Locale *__openlocale(const char *name) {
+	struct __localeopen *o;
+	struct Locale *locale;
+	if (name[0] != '\0')
+		for (o = __localesopen; o != NULL; o = o->next)
+			if (strcmp(o->name, name) == 0 || (o->locale->loc_LocaleName != NULL
+					&& strcmp((const char *) o->locale->loc_LocaleName, name) == 0))
+				return o->locale;
+	if ((locale = OpenLocale(name[0] == '\0' ? NULL : (STRPTR) name)) == NULL)
+		return NULL;
+	for (o = __localesopen; o != NULL; o = o->next)
+		if (o->locale == locale) { /* the default locale again */
+			CloseLocale(locale);
+			return locale;
+		}
+	if ((o = malloc(sizeof(*o) + strlen(name))) == NULL) {
+		CloseLocale(locale);
+		return NULL;
+	}
+	strcpy(o->name, name);
+	o->locale = locale;
+	o->next = __localesopen;
+	__localesopen = o;
+	return locale;
+}
+#endif
 
-	if (name == NULL) /* return name of current locale */
-	{
-		size_t s = 0;
-		for (i = a; i <= b; i++) {
+static char *__getlocalename(size_t a, size_t b) {
+	size_t i, s = 0;
+	char *string, *name;
+
+	for (i = a; i <= b; i++) {
 #ifndef __KICK13__
-			if (__localevec[i] != NULL)
-				s += strlen((const char *) __localevec[i]->loc_LocaleName);
-			else
+		if (__localevec[i] != NULL)
+			s += strlen((const char *) __localevec[i]->loc_LocaleName) + 1;
+		else
 #endif
-				s++; /* "C" locale */
-		}
+			s += 2; /* "C" */
+	}
 
-		if ((string = malloc(s + b - a + 1)) == NULL)
-			return NULL;
+	if ((string = malloc(s)) == NULL)
+		return NULL;
 
-		string[0] = '\0';
-		for (i = a; i <= b; i++) {
+	string[0] = '\0';
+	for (i = a; i <= b; i++) {
 #ifndef __KICK13__
-			if (__localevec[i] != NULL)
-				strcat(string, (const char *) __localevec[i]->loc_LocaleName);
-			else
+		if (__localevec[i] != NULL)
+			strcat(string, (const char *) __localevec[i]->loc_LocaleName);
+		else
 #endif
-				strcat(string, "C");
-			if (i != b)
-				strcat(string, "\n");
-		}
-		return string;
+			strcat(string, "C");
+		if (i != b)
+			strcat(string, "\n");
 	}
+	name = __keepname(string);
+	free(string);
+	return name;
+}
 
-	string = strdup(name); /* gets freed next time or at end */
+static char *__setlocale(size_t a, size_t b, const char *name) {
+	size_t i;
+	struct Locale *vec[5];
+	char *string, *s1, *s2, c;
 
+	if ((string = strdup(name)) == NULL)
+		return NULL;
+
+	/* one name for all the categories, or one per category, each ended by
+	   a newline, as __getlocalename() makes them */
 	s1 = s2 = string;
 	for (i = a; i <= b; i++) {
 		while (*s2 != '\0' && *s2 != '\n')
@@ -98,10 +177,9 @@ char *setlocale(int category, const char *name) {
 #ifndef __KICK13__
 		if (LocaleBase == NULL || (s1[0] == 'C' && s1[1] == '\0')) /* This is the only place */
 			vec[i] = NULL; /* LocaleBase gets tested for NULL */
-		else if ((vec[i] = OpenLocale(s1[0]=='\0'?NULL:(STRPTR)s1)) == NULL) {
-			for (; i-- > a;)
-				CloseLocale(vec[i]);
-			return NULL;
+		else if ((vec[i] = __openlocale(s1)) == NULL) {
+			free(string);
+			return NULL; /* nothing has changed */
 		}
 #else
 		vec[i] = NULL;
@@ -109,24 +187,29 @@ char *setlocale(int category, const char *name) {
 		*s2 = c;
 		if (c == '\0')
 			s2 = string;
+		else
+			s2++;
 		s1 = s2;
 	}
+	free(string);
 
-	for (i = a; i <= b; i++) {
-#ifndef __KICK13__
-		if (__localevec[i] != NULL)
-			CloseLocale(__localevec[i]);
-#endif
-		__localevec[i] = vec[i];
-	}
+	for (i = a; i <= b; i++)
+		__localevec[i] = vec[i]; /* closed at exit, not now: another thread may use it */
+
+	// set defaults
+	__lconv.decimal_point = ".";
+	__lconv.thousands_sep = "";
 
 #ifndef __KICK13__
-	if (__localevec[LC_CTYPE - 1] != NULL) {
+	if (__localevec[LC_CTYPE - 1] != NULL && ctype != NULL) {
 		struct Locale *locale = __localevec[LC_CTYPE - 1];
-		ctype[0] = 0;
-		for (i = 0; i < 256; i++)
-			ctype[i + 1] = ((IsPrint(locale,i) && !IsGraph(locale, i)) ? 128 : 0) | (IsXDigit(locale,i) ? 64 : 0) | (IsCntrl(locale,i) ? 32 : 0) | (IsPunct(locale,i) ? 16 : 0)
-					| (IsSpace(locale,i) ? 8 : 0) | (IsDigit(locale,i) ? 4 : 0) | (IsLower(locale,i) ? 2 : 0) | (IsUpper(locale,i) ? 1 : 0);
+		if (locale != __ctypelocale) {
+			ctype[0] = 0;
+			for (i = 0; i < 256; i++)
+				ctype[i + 1] = ((IsPrint(locale,i) && !IsGraph(locale, i)) ? 128 : 0) | (IsXDigit(locale,i) ? 64 : 0) | (IsCntrl(locale,i) ? 32 : 0) | (IsPunct(locale,i) ? 16 : 0)
+						| (IsSpace(locale,i) ? 8 : 0) | (IsDigit(locale,i) ? 4 : 0) | (IsLower(locale,i) ? 2 : 0) | (IsUpper(locale,i) ? 1 : 0);
+			__ctypelocale = locale;
+		}
 		_ctype_ = ctype;
 	} else
 #endif
@@ -177,13 +260,14 @@ char *setlocale(int category, const char *name) {
 #else
 		__lconv.decimal_point = (char*) ".";
 #endif
-		__decimalpoint = __lconv.decimal_point;
 #ifndef __KICK13__
 		__lconv.thousands_sep = (char*) locale->loc_GroupSeparator;
 #else
 		__lconv.thousands_sep = (char*)",";
 #endif
 	}
+	/* "C" gives printf() and scanf() the point back too */
+	__decimalpoint = __lconv.decimal_point;
 
 #ifndef __KICK13__
 	if (__localevec[LC_TIME - 1] != NULL)
@@ -195,6 +279,28 @@ char *setlocale(int category, const char *name) {
 	return (char *) name;
 }
 
+char *setlocale(int category, const char *name) {
+	size_t a, b;
+	char *result;
+
+	if (category < 0 || category > 5)
+		return NULL;
+
+	if (category == LC_ALL) {
+		a = 0;
+		b = 4;
+	} else
+		a = b = category - 1;
+
+	__localelock();
+	if (name == NULL) /* return name of current locale */
+		result = __getlocalename(a, b);
+	else
+		result = __setlocale(a, b, name);
+	__localeunlock();
+	return result;
+}
+
 void __initlocale(void) {
 	if ((ctype = malloc(257)) != NULL) {
 		if (setlocale(LC_ALL, "") != NULL) /* Set the default locale */
@@ -203,14 +309,20 @@ void __initlocale(void) {
 }
 
 void __exitlocale(void) {
+	struct __localename *n;
 #ifndef __KICK13__
-	int i;
-	for (i = 0; i < 5; i++)
-		if (__localevec[i] != NULL)
-			CloseLocale(__localevec[i]);
+	struct __localeopen *o;
+	while ((o = __localesopen) != NULL) {
+		__localesopen = o->next;
+		CloseLocale(o->locale);
+		free(o);
+	}
 #endif
+	while ((n = __localenames) != NULL) {
+		__localenames = n->next;
+		free(n);
+	}
 }
 
 ADD2INIT(__initlocale, -10);
 ADD2EXIT(__exitlocale, -10);
-
-- 
